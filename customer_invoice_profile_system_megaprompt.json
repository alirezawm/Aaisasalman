  "database_schema": {
    "new_tables": {
      "customer_invoice_profile": {
        "id": "INTEGER PRIMARY KEY",
        "user_id": "INTEGER REFERENCES user(id)",
        "customer_type": "VARCHAR(20) DEFAULT 'individual'",
        "auto_approval_limit": "DECIMAL(15,2) DEFAULT 1000000",
        "bulk_discount_percentage": "DECIMAL(5,2) DEFAULT 0",
        "credit_limit": "DECIMAL(15,2) DEFAULT 0",
        "current_credit_used": "DECIMAL(15,2) DEFAULT 0",
        "assigned_sales_manager": "INTEGER REFERENCES user(id)",
        "created_at": "DATETIME DEFAULT CURRENT_TIMESTAMP",
        "updated_at": "DATETIME DEFAULT CURRENT_TIMESTAMP"
      },
      "invoice_approval_workflow": {
        "id": "INTEGER PRIMARY KEY",
        "invoice_id": "INTEGER REFERENCES invoice(id)",
        "workflow_status": "VARCHAR(30) DEFAULT 'pending'",
        "auto_approval_eligible": "BOOLEAN DEFAULT FALSE",
        "manual_approval_required": "BOOLEAN DEFAULT TRUE",
        "assigned_to": "INTEGER REFERENCES user(id)",
        "priority_level": "INTEGER DEFAULT 1",
        "deadline": "DATETIME",
        "approval_notes": "TEXT",
        "created_at": "DATETIME DEFAULT CURRENT_TIMESTAMP",
        "updated_at": "DATETIME DEFAULT CURRENT_TIMESTAMP"
      },
      "bulk_customer_benefits": {
        "id": "INTEGER PRIMARY KEY",
        "user_id": "INTEGER REFERENCES user(id)",
        "benefit_type": "VARCHAR(50)",
        "benefit_value": "DECIMAL(10,2)",
        "is_active": "BOOLEAN DEFAULT TRUE",
        "valid_from": "DATETIME",
        "valid_until": "DATETIME",
        "created_at": "DATETIME DEFAULT CURRENT_TIMESTAMP"
      },
      "invoice_document_approval": {
        "id": "INTEGER PRIMARY KEY",
        "document_id": "INTEGER REFERENCES invoice_document(id)",
        "approval_status": "VARCHAR(20) DEFAULT 'pending'",
        "approved_by": "INTEGER REFERENCES user(id)",
        "approval_date": "DATETIME",
        "rejection_reason": "TEXT",
        "admin_notes": "TEXT",
        "created_at": "DATETIME DEFAULT CURRENT_TIMESTAMP"
      }
    },
    "table_modifications": {
      "invoice": [
        "ADD COLUMN customer_type VARCHAR(20) DEFAULT 'individual'",
        "ADD COLUMN approval_workflow_status VARCHAR(30) DEFAULT 'pending'",
        "ADD COLUMN document_required BOOLEAN DEFAULT FALSE",
        "ADD COLUMN auto_approval_threshold DECIMAL(15,2) DEFAULT 1000000",
        "ADD COLUMN bulk_discount_applied DECIMAL(5,2) DEFAULT 0",
        "ADD COLUMN credit_used DECIMAL(15,2) DEFAULT 0",
        "ADD COLUMN sales_manager_id INTEGER REFERENCES user(id)",
        "ADD COLUMN customer_notes TEXT"
      ],
      "user": [
        "ADD COLUMN customer_type VARCHAR(20) DEFAULT 'individual'",
        "ADD COLUMN sales_manager_id INTEGER REFERENCES user(id)",
        "ADD COLUMN bulk_customer_level VARCHAR(20) DEFAULT 'bronze'",
        "ADD COLUMN total_purchase_amount DECIMAL(15,2) DEFAULT 0"
      ]
    }
  },

