  "database_changes": {
    "new_tables": [],
    "modified_tables": [],
    "new_indexes": [
      "CREATE INDEX idx_invoice_user_status ON invoice(user_id, approval_status)",
      "CREATE INDEX idx_invoice_created_status ON invoice(created_at, approval_status)",
      "CREATE INDEX idx_invoice_payment_type ON invoice(payment_type, approval_status)"
    ],
    "migrations": [
      "Add indexes for better query performance",
      "Update existing invoice queries for optimization"
    ]
  },

  "api_endpoints": {
    "GET /profile/customer-invoices": {
      "description": "Display customer invoices page in profile",
      "authentication": "Required",
      "permissions": "order.read, user.read",
      "parameters": {
        "page": "Page number for pagination",
        "status": "Filter by approval status",
        "payment_type": "Filter by payment type",
        "search": "Search by customer name or invoice number",
        "date_from": "Filter from date",
        "date_to": "Filter to date"
      },
      "response": "HTML template with invoice data"
    },
    "GET /api/profile/customer-invoices": {
      "description": "Get customer invoices data as JSON",
      "authentication": "Required",
      "permissions": "order.read, user.read",
      "response": {
        "success": "boolean",
        "invoices": "array of invoice objects",
        "pagination": "pagination info",
        "statistics": "invoice statistics",
        "filters": "current filter values"
      }
    },
    "PUT /api/profile/customer-invoices/{invoice_id}/approve": {
      "description": "Approve a customer invoice",
      "authentication": "Required",
      "permissions": "order.update",
      "parameters": {
        "admin_notes": "Optional admin notes"
      },
      "response": {
        "success": "boolean",
        "message": "Success message",
        "invoice": "Updated invoice object"
      }
    },
    "PUT /api/profile/customer-invoices/{invoice_id}/reject": {
      "description": "Reject a customer invoice",
      "authentication": "Required",
      "permissions": "order.update",
      "parameters": {
        "rejection_reason": "Required rejection reason",
        "admin_notes": "Optional admin notes"
      },
      "response": {
        "success": "boolean",
        "message": "Success message",
        "invoice": "Updated invoice object"
      }
    },
    "GET /api/profile/customer-invoices/{invoice_id}/details": {
      "description": "Get detailed invoice information",
      "authentication": "Required",
      "permissions": "order.read",
      "response": {
        "success": "boolean",
        "invoice": "Detailed invoice object with items and customer info"
      }
    }
  },

