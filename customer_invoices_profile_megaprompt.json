  "requirements": {
    "functional": [
      "Add customer invoices section to user profile page",
      "Display all customer invoices with filtering and search capabilities",
      "Show invoice details including items, amounts, and status",
      "Provide invoice management actions (approve, reject, view details)",
      "Implement responsive design for mobile and desktop",
      "Add pagination for large invoice lists",
      "Include invoice statistics and summary",
      "Support real-time updates and notifications"
    ],
    "technical": [
      "Use existing role-based access control system",
      "Integrate with current invoice management system",
      "Maintain database consistency and performance",
      "Follow existing UI/UX patterns and Persian RTL design",
      "Implement proper error handling and validation",
      "Add audit logging for invoice management actions",
      "Ensure mobile responsiveness",
      "Use existing authentication and authorization"
    ],
    "security": [
      "Restrict access to users with 'مدیر_سفارشات' (order_manager) role only",
      "Validate user permissions before displaying invoices",
      "Implement CSRF protection for all forms",
      "Log all invoice management actions",
      "Sanitize user inputs and prevent SQL injection",
      "Use secure file handling for invoice documents"
    ]
  },

