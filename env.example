# ========================================
# Environment Configuration Example
# Asia Salman Flask Application
# ========================================

# Flask Configuration
FLASK_ENV=production
FLASK_APP=app.py
SECRET_KEY=your-super-secret-key-here-change-this-in-production

# Database Configuration
DATABASE_URL=sqlite:///asia_salman.db
SQLALCHEMY_DATABASE_URI=sqlite:///asia_salman.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Application Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif,doc,docx,xls,xlsx

# Security Settings
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Tadbir API Configuration
TADBIR_API_URL=https://your-tadbir-api.com
TADBIR_USERNAME=your-username
TADBIR_PASSWORD=your-password
TADBIR_DATABASE=your-database

# ISACO Warehouse Configuration
ENABLE_ISACO_WH15=True
ISACO_BRAND_ID=63
ISACO_WAREHOUSE_ID=15
ISACO_ALLOWED_PLANS=isaco_cash,isaco_1m,isaco_2m,isaco_3m

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Performance Settings
WORKERS=4
WORKER_CONNECTIONS=1000
TIMEOUT=120
KEEPALIVE=5

# Monitoring and Health Checks
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_INTERVAL=24  # hours
BACKUP_RETENTION_DAYS=7
BACKUP_COMPRESSION=True

# SSL/TLS Configuration (for HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_ENABLED=False

# Domain Configuration
DOMAIN_NAME=your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Cache Configuration
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://redis:6379/1
CACHE_DEFAULT_TIMEOUT=300

# File Upload Settings
MAX_FILE_SIZE=20971520  # 20MB
UPLOAD_PATH=uploads
TEMP_PATH=temp

# Persian Date Configuration
PERSIAN_DATE_ENABLED=True
TIMEZONE=Asia/Tehran

# Points System Configuration
POINTS_ENABLED=True
POINTS_PER_100K_RIALS=500
POINTS_EXPIRY_DAYS=365

# Notification Settings
NOTIFICATIONS_ENABLED=True
EMAIL_NOTIFICATIONS=True
SMS_NOTIFICATIONS=False

# Development/Testing (set to False in production)
DEBUG=False
TESTING=False
