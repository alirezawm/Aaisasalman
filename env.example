# تنظیمات محیط (Environment Variables)
# این فایل را کپی کنید و نام آن را به .env تغییر دهید

# ============================================
# کلیدهای امنیتی
# ============================================
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# ============================================
# تنظیمات دیتابیس
# ============================================
# مسیر دیتابیس (اختیاری - به صورت خودکار تشخیص داده می‌شود)
# در سرور: /root/data/ استفاده می‌شود
# در محیط محلی: ../data/ استفاده می‌شود
# DATABASE_DIR=/root/data
# DATABASE_DIR=/path/to/custom/data/directory

# برای PostgreSQL (در صورت استفاده):
# DATABASE_URL=postgresql://user:password@localhost/asiasalman

# ============================================
# تنظیمات Flask
# ============================================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=app.py

# ============================================
# تنظیمات JWT
# ============================================
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour in seconds
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 days in seconds

# ============================================
# تنظیمات CORS
# ============================================
CORS_ORIGINS=*
# برای Production محدود کنید:
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ============================================
# تنظیمات ISACO
# ============================================
ENABLE_ISACO_WH15=True
ISACO_BRAND_ID=63
ISACO_WAREHOUSE_ID=15

# ============================================
# تنظیمات SMS
# ============================================
ENABLE_WELCOME_SMS=True
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://api.sms-provider.com

# ============================================
# تنظیمات Email (اختیاری)
# ============================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password

# ============================================
# تنظیمات Redis (اختیاری)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# تنظیمات Production
# ============================================
# برای Production:
# FLASK_ENV=production
# FLASK_DEBUG=False
# SESSION_COOKIE_SECURE=True
# USE_HTTPS=True

# ============================================
# تنظیمات API موبایل
# ============================================
MOBILE_API_BASE_URL=https://yoursite.com/api/mobile/v1
MOBILE_API_VERSION=v1

# ============================================
# تنظیمات Logging
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
