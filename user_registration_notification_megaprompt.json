    "step_8_javascript_notifications": {
      "description": "JavaScript برای مدیریت اعلان‌ها",
      "code": {
        "static/js/profile-notifications.js": {
          "content": """
$(document).ready(function() {
    loadNotifications();
    
    // بارگذاری اعلان‌ها
    function loadNotifications() {
        $.ajax({
            url: '/api/notifications',
            method: 'GET',
            success: function(response) {
                if (response.success) {
                    displayNotifications(response.notifications);
                    updateNotificationCount(response.unread_count);
                }
            }
        });
    }
    
    // نمایش اعلان‌ها
    function displayNotifications(notifications) {
        const container = $('#notifications-container');
        container.empty();
        
        if (notifications.length === 0) {
            container.html('<p class="text-muted text-center">اعلانی وجود ندارد</p>');
            return;
        }
        
        notifications.forEach(function(notification) {
            const notificationHtml = `
                <div class="alert ${notification.is_read ? 'alert-light' : 'alert-warning'} mb-3" 
                     data-notification-id="${notification.id}">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <h6 class="alert-heading">${notification.title}</h6>
                            <p class="mb-2">${notification.message}</p>
                            <small class="text-muted">
                                ${new Date(notification.created_at).toLocaleDateString('fa-IR')}
                            </small>
                        </div>
                        ${!notification.is_read ? 
                            '<button class="btn btn-sm btn-outline-primary mark-read-btn">خوانده شد</button>' : 
                            '<span class="badge bg-success">خوانده شده</span>'
                        }
                    </div>
                </div>
            `;
            container.append(notificationHtml);
        });
        
        // رویداد کلیک برای علامت‌گذاری به عنوان خوانده شده
        $('.mark-read-btn').on('click', function() {
            const notificationId = $(this).closest('.alert').data('notification-id');
            markAsRead(notificationId);
        });
    }
    
    // علامت‌گذاری به عنوان خوانده شده
    function markAsRead(notificationId) {
        $.ajax({
            url: '/api/notifications/read',
            method: 'PUT',
            contentType: 'application/json',
            data: JSON.stringify({notification_id: notificationId}),
            success: function(response) {
                if (response.success) {
                    loadNotifications(); // بارگذاری مجدد
                }
            }
        });
    }
    
    // به‌روزرسانی شمارنده اعلان‌ها
    function updateNotificationCount(count) {
        $('#notification-count').text(count);
    }
});
          """
        }
      }
    }
