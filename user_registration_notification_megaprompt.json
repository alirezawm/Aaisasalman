    "step_6_profile_update_route": {
      "description": "ایجاد route برای به‌روزرسانی پروفایل",
      "code": {
        "routes.py": {
          "new_route": """
@app.route('/update_profile', methods=['POST'])
@login_required
def update_profile():
    \"\"\"به‌روزرسانی پروفایل کاربر\"\"\"
    try:
        # دریافت داده‌ها
        current_user.national_id = request.form.get('national_id', '').strip()
        current_user.address = request.form.get('address', '').strip()
        current_user.landline_phone = request.form.get('landline_phone', '').strip()
        current_user.secondary_phone = request.form.get('secondary_phone', '').strip()
        
        # تاریخ تولد
        birth_date_str = request.form.get('birth_date', '').strip()
        if birth_date_str:
            try:
                current_user.birth_date = datetime.strptime(birth_date_str, '%Y-%m-%d').date()
            except ValueError:
                flash('فرمت تاریخ تولد نامعتبر است', 'error')
                return redirect(url_for('profile'))
        
        # محاسبه درصد تکمیل پروفایل
        completion_percentage = current_user.calculate_profile_completion()
        
        # ذخیره تغییرات
        db.session.commit()
        
        # ارسال اعلان در صورت تکمیل پروفایل
        if completion_percentage == 100:
            completion_notification = models.UserNotification(
                user_id=current_user.id,
                notification_type='profile_completed',
                title='پروفایل تکمیل شد',
                message='پروفایل شما با موفقیت تکمیل شد. اکنون می‌توانید از تمام خدمات و امکانات سایت استفاده کنید.'
            )
            db.session.add(completion_notification)
            db.session.commit()
            
            flash('پروفایل شما با موفقیت تکمیل شد!', 'success')
        else:
            flash('اطلاعات پروفایل به‌روزرسانی شد', 'success')
        
        return redirect(url_for('profile'))
        
    except Exception as e:
        db.session.rollback()
        flash('خطا در به‌روزرسانی پروفایل', 'error')
        return redirect(url_for('profile'))
          """
        }
      }
    },

