    "step_2_profile_completion_logic": {
      "description": "پیاده‌سازی منطق محاسبه درصد تکمیل پروفایل",
      "code": {
        "models.py": {
          "method": "calculate_profile_completion",
          "implementation": """
def calculate_profile_completion(self):
    \"\"\"محاسبه درصد تکمیل پروفایل\"\"\"
    total_fields = 8
    completed_fields = 0
    
    # فیلدهای اجباری
    if self.full_name:
        completed_fields += 1
    if self.email:
        completed_fields += 1
    if self.phone:
        completed_fields += 1
    if self.username:
        completed_fields += 1
    
    # فیلدهای اختیاری
    if self.national_id:
        completed_fields += 1
    if self.birth_date:
        completed_fields += 1
    if self.address:
        completed_fields += 1
    if self.landline_phone or self.secondary_phone:
        completed_fields += 1
    
    percentage = int((completed_fields / total_fields) * 100)
    self.profile_completion_percentage = percentage
    
    # اگر پروفایل کامل شد
    if percentage == 100 and not self.profile_completed_at:
        self.profile_completed_at = datetime.utcnow()
    
    return percentage
          """
        }
      }
    },

    "step_3_notification_system": {
      "description": "پیاده‌سازی سیستم اعلان‌های هوشمند",
      "code": {
        "routes.py": {
          "function": "send_registration_notifications",
          "implementation": """
def send_registration_notifications(user):
    \"\"\"ارسال اعلان‌های پس از ثبت نام\"\"\"
    from datetime import datetime
    
    # اعلان خوش آمدگویی عمومی
    welcome_notification = models.UserNotification(
        user_id=user.id,
        notification_type='welcome',
        title='خوش آمدید به آسیا سلمان',
        message='به خانواده آسیا سلمان خوش آمدید! لطفاً پروفایل خود را تکمیل کنید تا از خدمات کامل بهره‌مند شوید.'
    )
    db.session.add(welcome_notification)
    
    # اعلان ویژه خریداران عمده
    if user.is_bulk_buyer:
        bulk_notification = models.UserNotification(
            user_id=user.id,
            notification_type='bulk_buyer_welcome',
            title='خوش آمدید - خریدار عمده',
            message='به عنوان خریدار عمده، از قیمت‌های ویژه، شرایط پرداخت خاص و خدمات اختصاصی بهره‌مند شوید.'
        )
        db.session.add(bulk_notification)
    
    # اعلان تکمیل پروفایل
    profile_notification = models.UserNotification(
        user_id=user.id,
        notification_type='profile_incomplete',
        title='تکمیل پروفایل',
        message='پروفایل شما ناقص است. برای دریافت خدمات بهتر و دسترسی به امکانات کامل، اطلاعات خود را تکمیل کنید.'
    )
    db.session.add(profile_notification)
    
    db.session.commit()
          """
        }
      }
    },

