  "rtl_support": {
    "enabled": true,
    "config": {
      "layout_direction": "RTL",
      "text_alignment": "Start (Right for RTL)",
      "letter_spacing": "0.sp for Persian",
      "line_height_multiplier": 1.5
    }
  },
  
  "optimization": {
    "subset_font": {
      "recommended": true,
      "tool": "fonttools",
      "characters": "Persian, Arabic, English, Numbers, Basic Symbols"
    },
    "variable_font": {
      "available": false,
      "note": "اگر نسخه variable font موجود شود، استفاده کنید"
    },
    "font_loading": {
      "method": "Lazy loading",
      "cache": true,
      "fallback": "System font with Persian support"
    }
  },
  
  "website_compatibility": {
