{
  "title": "Text Color Optimization Megaprompt",
  "description": "A comprehensive prompt for optimizing text colors to ensure maximum readability against any background color",
  "version": "1.0",
  "language": "Persian/English",
  "purpose": "Generate optimal text colors that provide maximum contrast and readability against any background",
  
  "system_prompt": {
    "role": "system",
    "content": "You are an expert in color theory, accessibility, and UI/UX design. Your task is to analyze background colors and determine the optimal text color that ensures maximum readability, contrast, and accessibility compliance. You must consider WCAG guidelines, color psychology, and visual hierarchy principles."
  },
  
  "main_prompt": {
    "role": "user",
    "content": "Analyze the following background color and determine the optimal text color for maximum readability:\n\nBackground Color: {background_color}\n\nPlease provide:\n1. **Primary Text Color** (for main content)\n2. **Secondary Text Color** (for subtitles, captions)\n3. **Accent Text Color** (for highlights, links)\n4. **Contrast Ratio** (WCAG compliance level)\n5. **Accessibility Score** (A, AA, or AAA)\n6. **Color Psychology Impact** (how the combination affects user perception)\n7. **Alternative Options** (2-3 alternative color schemes)\n8. **Implementation Code** (CSS/HTML examples)\n\nConsider these factors:\n- WCAG 2.1 AA/AAA contrast requirements (4.5:1 for normal text, 3:1 for large text)\n- Color blindness compatibility\n- Cultural color associations\n- Brand consistency\n- Visual hierarchy\n- Screen readability across devices\n- Print compatibility\n- Dark/light mode considerations"
  },
  
  "color_analysis_framework": {
    "background_analysis": {
      "lightness": "Calculate relative luminance (0-1 scale)",
      "saturation": "Determine color intensity",
      "hue": "Identify color family",
      "temperature": "Warm, cool, or neutral",
      "brightness": "Light, medium, or dark"
    },
    
    "contrast_calculation": {
      "formula": "WCAG contrast ratio formula",
      "minimum_ratios": {
        "normal_text": "4.5:1 (AA), 7:1 (AAA)",
        "large_text": "3:1 (AA), 4.5:1 (AAA)",
        "ui_components": "3:1 (AA)"
      }
    },
    
    "color_recommendations": {
      "light_backgrounds": {
        "primary": "Dark colors (#000000, #333333, #1a1a1a)",
        "secondary": "Medium dark (#666666, #4a4a4a)",
        "accent": "Brand colors with sufficient contrast"
      },
      "dark_backgrounds": {
        "primary": "Light colors (#ffffff, #f8f9fa, #e9ecef)",
        "secondary": "Medium light (#adb5bd, #6c757d)",
        "accent": "Bright colors (#007bff, #28a745)"
      },
      "colored_backgrounds": {
        "approach": "Complementary or contrasting colors",
        "consideration": "Avoid similar hues, ensure sufficient contrast"
      }
    }
  },
  
  "output_format": {
    "structure": {
      "analysis": {
        "background_properties": "Detailed background color analysis",
        "contrast_requirements": "WCAG compliance needs",
        "accessibility_considerations": "Special requirements"
      },
      "recommendations": {
        "primary_text": {
          "color": "Hex code",
          "rgb": "RGB values",
          "hsl": "HSL values",
          "contrast_ratio": "Numerical ratio",
          "accessibility_level": "AA/AAA compliance"
        },
        "secondary_text": {
          "color": "Hex code",
          "rgb": "RGB values",
          "hsl": "HSL values",
          "contrast_ratio": "Numerical ratio",
          "accessibility_level": "AA/AAA compliance"
        },
        "accent_text": {
          "color": "Hex code",
          "rgb": "RGB values",
          "hsl": "HSL values",
          "contrast_ratio": "Numerical ratio",
          "accessibility_level": "AA/AAA compliance"
        }
