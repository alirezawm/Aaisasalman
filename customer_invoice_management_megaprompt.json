{
  "title": "سیستم مدیریت فاکتورهای مشتریان در داشبورد مدیر",
  "description": "ایجاد سیستم کامل مدیریت فاکتورهای مشتریان با قابلیت تایید، رد و اطلاع‌رسانی",
  "version": "1.0",
  "created_at": "2025-01-27",
  "requirements": {
    "overview": "ایجاد یک بخش کامل در داشبورد مدیر سیستم برای مدیریت فاکتورهای مشتریان که شامل نمایش، تایید، رد و اطلاع‌رسانی به مشتریان باشد",
    "features": [
      "نمایش تمام فاکتورهای مشتریان با فیلترهای پیشرفته",
      "مشاهده جزئیات کامل فاکتور و مستندات",
      "تایید فاکتور با امکان اضافه کردن یادداشت",
      "رد فاکتور با ذکر دلیل و اطلاع‌رسانی به مشتری",
      "سیستم اطلاع‌رسانی خودکار به مشتریان",
      "مدیریت مستندات فاکتور (چک، رسید و غیره)",
      "گزارش‌گیری و آمار فاکتورها"
    ]
  },
  "database_changes": {
    "new_tables": [],
    "existing_table_modifications": [
      {
        "table": "invoice",
        "add_columns": [
          {
            "name": "admin_review_notes",
            "type": "TEXT",
            "description": "یادداشت‌های ادمین در زمان بررسی فاکتور"
          },
          {
            "name": "notification_sent",
            "type": "BOOLEAN",
            "default": "FALSE",
            "description": "آیا اطلاع‌رسانی به مشتری ارسال شده است"
          },
          {
            "name": "notification_sent_at",
            "type": "DATETIME",
            "description": "زمان ارسال آخرین اطلاع‌رسانی"
          }
        ]
      },
      {
        "table": "user_notification",
        "add_columns": [
          {
            "name": "related_invoice_id",
            "type": "INTEGER",
            "foreign_key": "invoice.id",
            "description": "شناسه فاکتور مرتبط با اطلاع‌رسانی"
          },
          {
            "name": "notification_action",
            "type": "VARCHAR(50)",
            "description": "نوع عملیات (approve, reject, review)"
          }
        ]
      }
    ]
  },
  "backend_implementation": {
    "new_routes": [
      {
        "route": "/admin/invoices/management",
        "method": "GET",
        "function": "admin_invoice_management",
        "description": "صفحه اصلی مدیریت فاکتورهای مشتریان",
        "permissions": ["admin", "order_manager"],
        "features": [
          "نمایش لیست فاکتورها با فیلترهای پیشرفته",
          "آمار کلی فاکتورها",
          "جستجوی پیشرفته",
          "صفحه‌بندی"
        ]
      },
      {
        "route": "/admin/invoices/<int:invoice_id>/approve",
        "method": "POST",
        "function": "admin_approve_invoice_with_notification",
        "description": "تایید فاکتور با ارسال اطلاع‌رسانی",
        "permissions": ["admin", "order_manager"],
        "parameters": [
          "admin_notes (optional)",
          "send_notification (boolean)"
        ]
      },
      {
        "route": "/admin/invoices/<int:invoice_id>/reject",
        "method": "POST",
        "function": "admin_reject_invoice_with_notification",
        "description": "رد فاکتور با ارسال اطلاع‌رسانی",
        "permissions": ["admin", "order_manager"],
        "parameters": [
          "rejection_reason (required)",
          "admin_notes (optional)",
          "send_notification (boolean)"
        ]
      },
      {
        "route": "/admin/invoices/<int:invoice_id>/set-review",
        "method": "POST",
        "function": "admin_set_invoice_review",
        "description": "تنظیم فاکتور به حالت بررسی",
        "permissions": ["admin", "order_manager"],
        "parameters": [
          "admin_notes (optional)"
        ]
      },
      {
        "route": "/admin/invoices/<int:invoice_id>/documents",
        "method": "GET",
        "function": "admin_view_invoice_documents",
        "description": "مشاهده مستندات فاکتور",
        "permissions": ["admin", "order_manager"]
      },
      {
        "route": "/admin/invoices/<int:invoice_id>/documents/<int:document_id>/approve",
        "method": "POST",
        "function": "admin_approve_document",
        "description": "تایید مستند فاکتور",
        "permissions": ["admin", "order_manager"]
      },
      {
        "route": "/admin/invoices/<int:invoice_id>/documents/<int:document_id>/reject",
        "method": "POST",
        "function": "admin_reject_document",
        "description": "رد مستند فاکتور",
        "permissions": ["admin", "order_manager"],
        "parameters": [
          "rejection_reason (required)"
        ]
      },
      {
        "route": "/api/admin/invoices/statistics",
        "method": "GET",
        "function": "api_invoice_statistics",
        "description": "دریافت آمار فاکتورها به صورت JSON",
        "permissions": ["admin", "order_manager"]
      },
      {
        "route": "/api/admin/invoices/search",
        "method": "GET",
        "function": "api_invoice_search",
        "description": "جستجوی پیشرفته فاکتورها",
        "permissions": ["admin", "order_manager"],
        "parameters": [
          "status",
          "payment_type",
          "user_search",
          "date_from",
          "date_to",
          "amount_min",
          "amount_max"
        ]
      }
    ],
    "notification_service": {
      "function": "send_invoice_notification",
      "description": "ارسال اطلاع‌رسانی به مشتری در مورد تغییر وضعیت فاکتور",
      "notification_types": [
        {
          "type": "invoice_approved",
          "title": "فاکتور شما تایید شد",
          "message_template": "فاکتور شماره {invoice_number} شما با مبلغ {amount} ریال تایید شد. {admin_notes}"
        },
        {
          "type": "invoice_rejected",
          "title": "فاکتور شما رد شد",
          "message_template": "متأسفانه فاکتور شماره {invoice_number} شما رد شد. دلیل: {rejection_reason}. {admin_notes}"
        },
        {
          "type": "invoice_under_review",
          "title": "فاکتور شما در حال بررسی است",
          "message_template": "فاکتور شماره {invoice_number} شما در حال بررسی است. {admin_notes}"
        },
        {
          "type": "document_required",
          "title": "ارسال مستندات فاکتور",
          "message_template": "لطفاً مستندات مربوط به فاکتور شماره {invoice_number} را ارسال کنید."
        }
      ]
    }
  },
  "frontend_implementation": {
