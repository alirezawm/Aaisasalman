  "code_examples": {
    "points_calculation": {
      "description": "محاسبه امتیازات بر اساس قیمت و تعداد محصولات",
      "python_code": """
def calculate_points(invoice_total, product_count, points_rule):
    # امتیاز پایه بر اساس قیمت
    base_points = (invoice_total / 100000) * points_rule.points_per_100k_rials
    
    # امتیاز اضافی بر اساس تعداد محصولات
    if product_count > 1:
        bonus_points = min(
            (product_count - 1) * points_rule.bonus_points_per_product,
            points_rule.max_bonus_points
        )
    else:
        bonus_points = 0
    
    total_points = base_points + bonus_points
    return int(total_points)
      """
    },
    "user_level_detection": {
      "description": "تشخیص سطح کاربر بر اساس امتیازات",
      "python_code": """
def get_user_level(user_points):
    levels = UserLevel.query.filter(
        UserLevel.is_active == True,
        UserLevel.min_points <= user_points
    ).order_by(UserLevel.min_points.desc()).first()
    
    return levels if levels else None
      """
    },
    "reward_redemption": {
      "description": "استفاده از جایزه",
      "python_code": """
def redeem_reward(user_id, reward_id, invoice_id=None):
    user_points = UserPoints.query.filter_by(user_id=user_id).first()
    reward = Reward.query.filter_by(id=reward_id, is_active=True).first()
    
    if not user_points or not reward:
        return False, "جایزه یا کاربر یافت نشد"
    
    if user_points.current_points < reward.points_required:
        return False, "امتیاز کافی ندارید"
    
    # ایجاد تراکنش خرج امتیاز
    transaction = PointsTransaction(
        user_id=user_id,
        points_amount=-reward.points_required,
        transaction_type='spend',
        source_type='reward_redemption',
        source_id=reward_id,
        description=f"استفاده از جایزه: {reward.name_fa}"
    )
    
    # به‌روزرسانی امتیاز کاربر
    user_points.current_points -= reward.points_required
    user_points.total_spent_points += reward.points_required
    
    # ثبت استفاده از جایزه
    redemption = RewardRedemption(
        user_id=user_id,
        reward_id=reward_id,
        points_spent=reward.points_required,
        invoice_id=invoice_id,
        status='used'
    )
    
    db.session.add(transaction)
    db.session.add(redemption)
    db.session.commit()
    
    return True, "جایزه با موفقیت استفاده شد"
      """
    }
  },

  "database_migrations": {
    "create_points_tables": {
      "description": "ایجاد جداول سیستم امتیازدهی",
      "sql": """
-- جدول امتیازات کاربران
CREATE TABLE user_points (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    current_points INTEGER DEFAULT 0,
    total_earned_points INTEGER DEFAULT 0,
    total_spent_points INTEGER DEFAULT 0,
    last_updated DATETIME DEFAULT CURRENT_TIMESTAMP,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES user (id),
    UNIQUE(user_id)
);

-- جدول تراکنش‌های امتیازی
CREATE TABLE points_transaction (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    points_amount INTEGER NOT NULL,
    transaction_type VARCHAR(20) NOT NULL,
    source_type VARCHAR(30) NOT NULL,
    source_id INTEGER,
    description TEXT,
    expires_at DATETIME,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES user (id)
);

-- جدول جوایز
CREATE TABLE reward (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name VARCHAR(200) NOT NULL,
    name_fa VARCHAR(200) NOT NULL,
    description TEXT,
    description_fa TEXT,
    points_required INTEGER NOT NULL,
    discount_percentage DECIMAL(5,2),
    discount_amount DECIMAL(10,2),
    reward_type VARCHAR(30) NOT NULL,
    is_active BOOLEAN DEFAULT TRUE,
    max_redemptions INTEGER,
    current_redemptions INTEGER DEFAULT 0,
    valid_from DATETIME,
    valid_until DATETIME,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- جدول استفاده از جوایز
CREATE TABLE reward_redemption (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    reward_id INTEGER NOT NULL,
    points_spent INTEGER NOT NULL,
    invoice_id INTEGER,
    used_at DATETIME,
    status VARCHAR(20) DEFAULT 'pending',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES user (id),
    FOREIGN KEY (reward_id) REFERENCES reward (id),
    FOREIGN KEY (invoice_id) REFERENCES invoice (id)
);

-- جدول سطح‌بندی کاربران
CREATE TABLE user_level (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    level_name VARCHAR(50) NOT NULL,
    level_name_fa VARCHAR(50) NOT NULL,
    min_points INTEGER NOT NULL,
    max_points INTEGER,
    discount_percentage DECIMAL(5,2) DEFAULT 0,
    is_active BOOLEAN DEFAULT TRUE,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- جدول قوانین امتیازدهی
CREATE TABLE points_rule (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    rule_name VARCHAR(100) NOT NULL,
    rule_name_fa VARCHAR(100) NOT NULL,
    points_per_100k_rials INTEGER DEFAULT 500,
    bonus_points_per_product INTEGER DEFAULT 50,
    max_bonus_points INTEGER DEFAULT 1000,
    is_active BOOLEAN DEFAULT TRUE,
    valid_from DATETIME,
    valid_until DATETIME,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- ایندکس‌ها برای بهینه‌سازی عملکرد
CREATE INDEX idx_user_points_user_id ON user_points(user_id);
CREATE INDEX idx_points_transaction_user_id ON points_transaction(user_id);
CREATE INDEX idx_points_transaction_type ON points_transaction(transaction_type);
CREATE INDEX idx_reward_active ON reward(is_active);
CREATE INDEX idx_reward_redemption_user_id ON reward_redemption(user_id);
CREATE INDEX idx_user_level_points ON user_level(min_points, max_points);
      """
    }
  },

