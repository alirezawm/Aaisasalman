{
  "project_name": "Asia Salman Android E-Commerce Application",
  "version": "1.0.0",
  "language": "Persian (Farsi)",
  "target_platform": "Android (API Level 21+)",
  
  "overview": {
    "description": "یک نرم‌افزار اندروید حرفه‌ای برای فروشگاه آنلاین قطعات خودرو که با وب‌سایت Flask موجود همگام‌سازی می‌شود",
    "backend_url": "https://yoursite.com",
    "api_base_path": "/api/mobile/v1"
  },
  
  "technical_requirements": {
    "minimum_android_version": "Android 5.0 (API 21)",
    "target_android_version": "Android 14 (API 34)",
    "supported_screen_sizes": ["small", "normal", "large", "xlarge"],
    "supported_densities": ["mdpi", "hdpi", "xhdpi", "xxhdpi", "xxxhdpi"],
    "architecture": "MVVM (Model-View-ViewModel)",
    "programming_language": "Kotlin",
    "ui_framework": "Jetpack Compose",
    "min_sdk_version": 21,
    "target_sdk_version": 34,
    "compile_sdk_version": 34
  },
  
  "authentication": {
    "method": "Phone Number + OTP",
    "endpoints": {
      "send_otp": "/api/mobile/v1/auth/send-otp",
      "verify_otp": "/api/mobile/v1/auth/verify-otp",
      "refresh_token": "/api/mobile/v1/auth/refresh-token",
      "logout": "/api/mobile/v1/auth/logout"
    },
    "features": [
      "ورود با شماره تلفن",
      "ارسال کد تایید (OTP) از طریق SMS",
      "تایید کد و ایجاد session",
      "ذخیره توکن احراز هویت",
      "مدیریت خودکار refresh token",
      "خروج از حساب کاربری",
      "حفظ وضعیت ورود کاربر"
    ],
    "phone_validation": {
      "format": "شروع با 09",
      "length": "11 رقم",
      "regex": "^09[0-9]{9}$"
    },
    "session_management": {
      "token_expiry": "7 days",
      "refresh_token_expiry": "30 days",
      "auto_refresh": true
    }
  },
  
  "navigation_structure": {
    "type": "Bottom Navigation Bar",
    "items": [
      {
        "id": "shop",
        "label": "فروشگاه",
        "icon": "shop_icon",
        "route": "/shop"
      },
      {
        "id": "categories",
        "label": "دسته‌بندی‌ها",
        "icon": "categories_icon",
        "route": "/categories"
      },
      {
        "id": "suggestions",
        "label": "پیشنهادات روز",
        "icon": "suggestions_icon",
        "route": "/suggestions"
      },
      {
        "id": "rewards",
        "label": "جوایز",
        "icon": "rewards_icon",
        "route": "/rewards"
      },
      {
        "id": "orders",
        "label": "سفارشات",
        "icon": "orders_icon",
        "route": "/orders"
      },
      {
        "id": "profile",
        "label": "پروفایل",
        "icon": "profile_icon",
        "route": "/profile"
      }
    ]
  },
  
  "data_synchronization": {
    "strategy": "Real-time + Periodic Sync",
    "methods": [
      "WebSocket برای به‌روزرسانی لحظه‌ای قیمت‌ها",
      "REST API برای دریافت داده‌ها",
      "Polling هر 5 دقیقه برای بررسی تغییرات",
      "Cache محلی برای عملکرد بهتر",
      "Offline mode با استفاده از Room Database"
    ],
    "sync_endpoints": {
      "products": "/api/mobile/v1/products",
      "categories": "/api/mobile/v1/categories",
      "brands": "/api/mobile/v1/brands",
      "vehicle_types": "/api/mobile/v1/vehicle-types",
      "prices_update": "/api/mobile/v1/prices/sync",
      "last_update_check": "/api/mobile/v1/sync/last-update"
    },
    "sync_priority": [
      "قیمت‌ها (بالاترین اولویت)",
      "موجودی کالاها",
      "دسته‌بندی‌ها",
      "اطلاعات محصولات",
      "بنرها و تخفیفات"
    ]
  },
  
  "shop_page": {
    "layout": {
      "sections": [
        {
          "type": "header",
          "components": [
            {
              "component": "company_logo",
