  "database_schema_mobile": {
    "local_database": "Room Database",
    "tables": [
      {
        "name": "products",
        "columns": [
          "id, sku, name_fa, description_fa",
          "brand_id, category_id, subcategory_id",
          "retail_price_cash, retail_price_check",
          "bulk_price_cash, bulk_price_check",
          "stock_quantity, primary_image, images",
          "is_active, is_featured, last_synced_at"
        ]
      },
      {
        "name": "categories",
        "columns": [
          "id, name_fa, parent_id, image_url",
          "category_type (vehicle/brand), last_synced_at"
        ]
      },
      {
        "name": "cart_items",
        "columns": [
          "id, product_id, quantity, price_type",
          "unit_price, cart_type (cash/check)",
          "created_at, updated_at"
        ]
      },
      {
        "name": "orders",
        "columns": [
          "id, order_number, total_amount",
          "payment_type, status, created_at",
          "synced_with_server"
        ]
      },
      {
        "name": "user_profile",
        "columns": [
          "user_id, full_name, phone, email",
          "is_bulk_buyer, bulk_buyer_status",
          "profile_data_json, last_synced_at"
        ]
      }
    ]
  },
  
