      ]
    }
  },
  
  "template_snippets": {
    "daily_discounts_slider_html": {
      "code": "<section class=\"py-5 daily-discounts-section\">\n    <div class=\"container\">\n        <div class=\"section-header mb-4\">\n            <div class=\"d-flex justify-content-between align-items-center\">\n                <div>\n                    <h2 class=\"display-6 fw-bold mb-2\">\n                        <i class=\"fas fa-bolt text-warning me-2\"></i>\n                        تخفیفات شگفت‌انگیز روزانه\n                    </h2>\n                    <p class=\"text-muted mb-0\">پیشنهادهای ویژه امروز</p>\n                </div>\n                <a href=\"{{ url_for('shop') }}?discount_type=daily\" class=\"btn btn-outline-primary\">\n                    مشاهده همه\n                    <i class=\"fas fa-arrow-left me-2\"></i>\n                </a>\n            </div>\n        </div>\n        <div class=\"swiper daily-discounts-swiper\">\n            <div class=\"swiper-wrapper\" id=\"daily-discounts-container\">\n                <!-- Products will be loaded here via JavaScript -->\n            </div>\n            <div class=\"swiper-button-next\"></div>\n            <div class=\"swiper-button-prev\"></div>\n            <div class=\"swiper-pagination\"></div>\n        </div>\n    </div>\n</section>",
      "description": "HTML structure for daily discounts slider"
    },
    "monthly_discounts_slider_html": {
      "code": "<section class=\"py-5 monthly-discounts-section bg-light\">\n    <div class=\"container\">\n        <div class=\"section-header mb-4\">\n            <div class=\"d-flex justify-content-between align-items-center\">\n                <div>\n                    <h2 class=\"display-6 fw-bold mb-2\">\n                        <i class=\"fas fa-star text-warning me-2\"></i>\n                        تخفیفات ویژه ماهانه\n                    </h2>\n                    <p class=\"text-muted mb-0\">پیشنهادهای شگفت‌انگیز این ماه</p>\n                </div>\n                <a href=\"{{ url_for('shop') }}?discount_type=monthly\" class=\"btn btn-outline-primary\">\n                    مشاهده همه\n                    <i class=\"fas fa-arrow-left me-2\"></i>\n                </a>\n            </div>\n        </div>\n        <div class=\"swiper monthly-discounts-swiper\">\n            <div class=\"swiper-wrapper\" id=\"monthly-discounts-container\">\n                <!-- Products will be loaded here via JavaScript -->\n            </div>\n            <div class=\"swiper-button-next\"></div>\n            <div class=\"swiper-button-prev\"></div>\n            <div class=\"swiper-pagination\"></div>\n        </div>\n    </div>\n</section>",
      "description": "HTML structure for monthly discounts slider"
    },
    "product_card_html": {
      "code": "<div class=\"swiper-slide\">\n    <div class=\"product-card discount-card h-100\">\n        <div class=\"discount-badge\">{{discount_percentage}}%</div>\n        <div class=\"product-image-container\">\n            <img src=\"{{product_image}}\" alt=\"{{product_name}}\" class=\"product-image\" onerror=\"this.src='{{default_image}}'\">\n            <div class=\"add-to-cart-overlay\">\n                <button class=\"btn btn-primary btn-sm add-to-cart-btn\" data-product-id=\"{{product_id}}\">\n                    <i class=\"fas fa-shopping-cart me-1\"></i>\n                    افزودن به سبد\n                </button>\n            </div>\n        </div>\n        <div class=\"product-info\">\n            <h6 class=\"product-name\" title=\"{{product_name}}\">{{product_name}}</h6>\n            <small class=\"brand-name text-muted\">{{brand_name}}</small>\n            <div class=\"price-section mt-2\">\n                {% if original_price != discounted_price %}\n                <div class=\"original-price text-muted text-decoration-line-through\">\n                    {{original_price | format_price}}\n                </div>\n                {% endif %}\n                <div class=\"discounted-price fw-bold text-primary\">\n                    {{discounted_price | format_price}}\n                </div>\n                {% if discount_amount > 0 %}\n                <small class=\"discount-amount text-success\">\n                    {{discount_amount | format_price}} تخفیف\n                </small>\n                {% endif %}\n            </div>\n        </div>\n    </div>\n</div>",
      "description": "Product card template for slider"
    }
  },
  
