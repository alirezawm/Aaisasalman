{
  "project_name": "سیستم مدیریت تخفیفات و نمایش محصولات تخفیف‌دار",
  "version": "1.0.0",
  "description": "ایجاد سیستم کامل مدیریت تخفیفات در داشبورد مدیریت و نمایش محصولات تخفیف‌دار در صفحه اصلی با اسلایدرهای شبیه دیجی‌کالا",
  "language": "fa",
  "framework": "Flask",
  "database": "SQLite with SQLAlchemy",
  
  "requirements": {
    "backend": [
      "Flask",
      "SQLAlchemy",
      "Flask-Login",
      "datetime"
    ],
    "frontend": [
      "Bootstrap 5",
      "jQuery",
      "Swiper.js (for sliders)",
      "Font Awesome"
    ]
  },
  
  "database_models": {
    "existing_models": {
      "ProductDiscount": {
        "description": "مدل موجود برای تخفیفات محصولات",
        "fields": [
          "id (Integer, Primary Key)",
          "name (String 200)",
          "name_fa (String 200)",
          "description (Text)",
          "discount_percentage (Float)",
          "is_active (Boolean)",
          "start_date (DateTime)",
          "end_date (DateTime)",
          "created_at (DateTime)",
          "updated_at (DateTime)",
          "created_by (Integer, ForeignKey to User)"
        ],
        "relationships": [
          "products (Many-to-Many via ProductDiscountProduct)",
          "creator (Many-to-One to User)"
        ]
      },
      "ProductDiscountProduct": {
        "description": "جدول ارتباط محصولات با تخفیفات",
        "fields": [
          "discount_id (Integer, Primary Key, ForeignKey)",
          "product_id (Integer, Primary Key, ForeignKey)",
          "created_at (DateTime)"
        ]
      }
    },
    "modifications_needed": {
      "ProductDiscount": {
        "add_fields": [
          {
            "name": "discount_type",
            "type": "String(20)",
            "default": "daily",
            "description": "نوع تخفیف: 'daily' (روزانه) یا 'monthly' (ماهانه)"
          },
          {
            "name": "priority",
            "type": "Integer",
            "default": 0,
            "description": "اولویت نمایش (عدد بالاتر = اولویت بیشتر)"
          }
        ]
      }
    }
  },
  
  "admin_dashboard_features": {
    "section_name": "مدیریت تخفیفات",
    "route": "/admin/discounts",
    "template": "templates/admin/discounts.html",
    "sidebar_menu_item": {
      "icon": "fas fa-tags",
      "text": "تخفیفات",
      "position": "after 'اطلاعیه‌ها' menu item"
    },
    
    "pages": {
      "main_page": {
        "title": "مدیریت تخفیفات",
        "description": "مدیریت تخفیفات روزانه و ماهانه محصولات",
        "sections": [
          {
            "name": "لیست تخفیفات",
            "type": "table",
            "columns": [
              "نام تخفیف",
              "نوع (روزانه/ماهانه)",
              "درصد تخفیف",
              "تعداد محصولات",
              "وضعیت",
              "تاریخ شروع",
              "تاریخ پایان",
              "عملیات"
            ],
            "actions": [
              "مشاهده",
              "ویرایش",
              "حذف",
              "فعال/غیرفعال"
            ],
            "filters": [
              "فیلتر بر اساس نوع (روزانه/ماهانه)",
              "فیلتر بر اساس وضعیت (فعال/غیرفعال)",
              "جستجو در نام تخفیف"
            ]
          },
          {
            "name": "ایجاد تخفیف جدید",
            "type": "button",
            "action": "open_modal",
            "modal_id": "createDiscountModal"
          }
        ]
      },
      "discount_detail_page": {
        "route": "/admin/discounts/<int:discount_id>",
        "template": "templates/admin/discount_detail.html",
        "sections": [
          {
            "name": "اطلاعات تخفیف",
            "fields": [
              "نام تخفیف (فارسی)",
              "نام تخفیف (انگلیسی)",
              "توضیحات",
              "نوع تخفیف (روزانه/ماهانه)",
              "درصد تخفیف",
              "تاریخ شروع",
              "تاریخ پایان",
              "وضعیت (فعال/غیرفعال)",
              "اولویت نمایش"
            ]
          },
          {
            "name": "مدیریت محصولات",
            "type": "product_management",
            "features": [
              "جستجوی محصولات",
              "افزودن محصول به تخفیف",
              "حذف محصول از تخفیف",
              "نمایش لیست محصولات تخفیف‌دار",
              "جستجو در محصولات موجود"
            ],
            "search_functionality": {
              "search_by": [
                "نام محصول",
                "کد SKU",
                "کد OEM",
                "برند",
                "دسته‌بندی"
              ],
              "search_api": "/api/admin/discounts/search-products",
              "method": "GET",
              "parameters": {
                "query": "string",
                "discount_id": "integer (optional, to exclude already added products)"
              }
            },
            "add_product_api": "/api/admin/discounts/<int:discount_id>/add-product",
            "remove_product_api": "/api/admin/discounts/<int:discount_id>/remove-product",
            "product_list_api": "/api/admin/discounts/<int:discount_id>/products"
          }
        ]
      }
    },
    
    "modals": {
      "createDiscountModal": {
        "title": "ایجاد تخفیف جدید",
        "form_fields": [
          {
            "name": "name_fa",
            "label": "نام تخفیف (فارسی)",
            "type": "text",
            "required": true,
            "placeholder": "مثال: تخفیف ویژه نوروز"
          },
          {
            "name": "name",
            "label": "نام تخفیف (انگلیسی)",
            "type": "text",
            "required": true,
            "placeholder": "Example: Nowruz Special Discount"
          },
          {
            "name": "description",
            "label": "توضیحات",
            "type": "textarea",
            "required": false
          },
          {
            "name": "discount_type",
            "label": "نوع تخفیف",
            "type": "select",
            "required": true,
            "options": [
              {"value": "daily", "label": "روزانه"},
              {"value": "monthly", "label": "ماهانه"}
            ]
          },
          {
            "name": "discount_percentage",
            "label": "درصد تخفیف",
            "type": "number",
            "required": true,
            "min": 0,
            "max": 100,
            "step": 0.1
          },
          {
            "name": "start_date",
            "label": "تاریخ شروع",
            "type": "datetime-local",
            "required": false
          },
          {
            "name": "end_date",
            "label": "تاریخ پایان",
            "type": "datetime-local",
            "required": false
          },
          {
            "name": "priority",
            "label": "اولویت نمایش",
            "type": "number",
            "required": false,
            "default": 0,
            "min": 0,
            "max": 100
          },
          {
            "name": "is_active",
            "label": "فعال",
            "type": "checkbox",
            "default": true
          }
        ],
        "submit_api": "/api/admin/discounts/create",
        "method": "POST"
      },
      "editDiscountModal": {
        "title": "ویرایش تخفیف",
        "similar_to": "createDiscountModal",
        "load_data_api": "/api/admin/discounts/<int:discount_id>",
        "update_api": "/api/admin/discounts/<int:discount_id>/update",
        "method": "PUT"
      },
      "addProductModal": {
        "title": "افزودن محصول به تخفیف",
        "features": [
          "جستجوی محصولات",
          "نمایش نتایج جستجو",
          "انتخاب چندتایی محصولات",
          "افزودن به تخفیف"
        ],
        "search_input": {
          "placeholder": "جستجوی محصول (نام، SKU، OEM، برند...)",
          "min_length": 2,
          "debounce": 300
        },
        "results_display": {
          "type": "grid",
          "columns": [
            "تصویر",
            "نام محصول",
            "SKU",
            "برند",
            "قیمت",
            "عملیات"
          ],
          "pagination": true,
          "items_per_page": 12
        }
      }
    },
    
    "api_endpoints": {
      "list_discounts": {
        "route": "/api/admin/discounts",
        "method": "GET",
        "response": {
          "success": "boolean",
          "discounts": "array of discount objects",
          "pagination": "object"
        }
      },
      "get_discount": {
        "route": "/api/admin/discounts/<int:discount_id>",
        "method": "GET",
        "response": {
          "success": "boolean",
          "discount": "discount object with products"
        }
      },
      "create_discount": {
        "route": "/api/admin/discounts/create",
        "method": "POST",
        "request_body": {
          "name_fa": "string",
          "name": "string",
          "description": "string (optional)",
          "discount_type": "string (daily|monthly)",
          "discount_percentage": "float",
          "start_date": "datetime (optional)",
          "end_date": "datetime (optional)",
          "priority": "integer (optional)",
          "is_active": "boolean"
        },
        "response": {
          "success": "boolean",
          "message": "string",
          "discount_id": "integer"
        }
      },
      "update_discount": {
        "route": "/api/admin/discounts/<int:discount_id>/update",
        "method": "PUT",
        "request_body": "same as create_discount",
        "response": {
          "success": "boolean",
          "message": "string"
        }
      },
      "delete_discount": {
        "route": "/api/admin/discounts/<int:discount_id>/delete",
        "method": "DELETE",
        "response": {
          "success": "boolean",
          "message": "string"
        }
      },
      "toggle_discount_status": {
        "route": "/api/admin/discounts/<int:discount_id>/toggle-status",
        "method": "POST",
        "response": {
          "success": "boolean",
          "message": "string",
          "is_active": "boolean"
        }
      },
      "search_products": {
        "route": "/api/admin/discounts/search-products",
        "method": "GET",
        "query_parameters": {
          "query": "string",
          "discount_id": "integer (optional)",
          "page": "integer (optional)",
          "per_page": "integer (optional, default: 12)"
        },
        "response": {
          "success": "boolean",
          "products": "array of product objects",
          "pagination": "object"
        }
      },
      "add_product_to_discount": {
        "route": "/api/admin/discounts/<int:discount_id>/add-product",
        "method": "POST",
        "request_body": {
          "product_id": "integer"
        },
        "response": {
          "success": "boolean",
          "message": "string"
        }
      },
      "remove_product_from_discount": {
        "route": "/api/admin/discounts/<int:discount_id>/remove-product",
        "method": "DELETE",
        "query_parameters": {
          "product_id": "integer"
        },
        "response": {
          "success": "boolean",
          "message": "string"
        }
      },
      "get_discount_products": {
        "route": "/api/admin/discounts/<int:discount_id>/products",
        "method": "GET",
        "query_parameters": {
          "page": "integer (optional)",
          "per_page": "integer (optional, default: 20)"
        },
        "response": {
          "success": "boolean",
          "products": "array of product objects",
          "pagination": "object"
        }
      }
    }
  },
  
  "homepage_features": {
    "sliders": {
      "daily_discounts_slider": {
        "title": "تخفیفات شگفت‌انگیز روزانه",
        "subtitle": "پیشنهادهای ویژه امروز",
        "icon": "fas fa-bolt",
        "section_id": "daily-discounts-slider",
        "position": "after 'Featured Categories Section'",
        "api_endpoint": "/api/discounts/daily-products",
        "method": "GET",
        "query_parameters": {
          "limit": "integer (default: 20)"
        },
        "design": {
          "style": "digikala_amazing_slider",
          "container_class": "digikala-slider-container",
          "slider_class": "swiper daily-discounts-swiper",
          "card_class": "product-card discount-card",
          "features": [
            "Navigation arrows (prev/next)",
            "Pagination dots",
            "Auto-play (optional)",
