        }
      },
      "monthly_discounts_slider": {
        "title": "تخفیفات ویژه ماهانه",
        "subtitle": "پیشنهادهای شگفت‌انگیز این ماه",
        "icon": "fas fa-star",
        "section_id": "monthly-discounts-slider",
        "position": "after daily discounts slider",
        "api_endpoint": "/api/discounts/monthly-products",
        "method": "GET",
        "query_parameters": {
          "limit": "integer (default: 20)"
        },
        "design": "same as daily_discounts_slider",
        "product_card_design": "same as daily_discounts_slider"
      }
    },
    
    "api_endpoints": {
      "daily_discount_products": {
        "route": "/api/discounts/daily-products",
        "method": "GET",
        "query_parameters": {
          "limit": "integer (optional, default: 20)",
          "offset": "integer (optional, default: 0)"
        },
        "logic": {
          "filter": "ProductDiscount where discount_type='daily' AND is_active=true AND is_valid()",
          "order_by": "priority DESC, created_at DESC",
          "include": "products with stock_quantity > 0 AND is_active=true",
          "calculate": "discounted price for each product"
        },
        "response": {
          "success": "boolean",
          "products": [
            {
              "id": "integer",
              "name": "string",
              "name_fa": "string",
              "sku": "string",
              "primary_image": "string",
              "brand": {
                "id": "integer",
                "name": "string",
                "name_fa": "string"
              },
              "original_price": "float",
              "discounted_price": "float",
              "discount_percentage": "float",
              "discount_amount": "float",
              "stock_quantity": "integer",
              "discount_info": {
                "discount_id": "integer",
                "discount_name": "string",
                "discount_name_fa": "string"
              }
            }
          ],
          "total": "integer"
        }
      },
      "monthly_discount_products": {
        "route": "/api/discounts/monthly-products",
        "method": "GET",
        "query_parameters": "same as daily_discount_products",
        "logic": "same as daily but filter by discount_type='monthly'",
        "response": "same structure as daily_discount_products"
      }
    },
    
