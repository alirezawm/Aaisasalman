{
  "title": "سیستم تشخیص خودکار برند و نوع خودرو - بازسازی کامل",
  "title_en": "Vehicle Brand & Type Auto-Detection System - Complete Rebuild",
  "version": "2.0.0",
  "date": "2025-10-10",
  "description": "مگاپرامپت حرفه‌ای برای بازسازی کامل سیستم تشخیص خودکار برند و نوع خودرو با قابلیت اجرای یک کلیکی",
  
  "objectives": {
    "primary": "بازسازی و بهینه‌سازی کامل سیستم تشخیص خودکار برند و نوع خودرو از نام محصولات",
    "secondary": [
      "افزایش دقت تشخیص به بیش از 95%",
      "کاهش زمان پردازش به کمتر از 10 میلی‌ثانیه برای هر محصول",
      "پشتیبانی از تشخیص چندگانه (چند برند و نوع در یک متن)",
      "پشتیبانی کامل از زبان فارسی و انگلیسی",
      "سیستم یادگیری و بهبود خودکار",
      "رابط کاربری گرافیکی برای مدیریت",
      "API کامل برای یکپارچه‌سازی",
      "گزارش‌دهی پیشرفته و تحلیل آماری"
    ]
  },
  
  "architecture": {
    "components": [
      {
        "name": "Core Detection Engine",
        "file": "brand_vehicle_detector.py",
        "description": "موتور اصلی تشخیص با الگوریتم‌های پیشرفته"
      },
      {
        "name": "Detection Service",
        "file": "detection_service.py",
        "description": "سرویس لایه میانی برای مدیریت درخواست‌ها"
      },
      {
        "name": "Detection API",
        "file": "detection_api.py",
        "description": "API endpoints برای تشخیص"
      },
      {
        "name": "Learning Module",
        "file": "detection_learning.py",
        "description": "ماژول یادگیری و بهبود خودکار"
      },
      {
        "name": "Admin Interface",
        "file": "templates/admin/detection_manager.html",
        "description": "رابط مدیریت تشخیص"
      },
      {
        "name": "Detection Models",
        "file": "detection_models.py",
        "description": "مدل‌های دیتابیس برای تشخیص"
      },
      {
        "name": "Detection Utilities",
        "file": "detection_utils.py",
        "description": "توابع کمکی و ابزارها"
      },
      {
        "name": "Test Suite",
        "file": "tests/test_detection.py",
        "description": "تست‌های جامع سیستم"
      }
    ],
    "data_flow": [
      "ورودی متن (نام محصول)",
      "پیش‌پردازش و نرمال‌سازی",
      "تشخیص برند با الگوریتم‌های متعدد",
      "تشخیص نوع خودرو",
      "تشخیص مدل خودرو",
      "محاسبه امتیاز اطمینان",
      "ذخیره نتایج",
      "یادگیری از نتایج"
    ]
  },
  
  "implementation_steps": [
    {
      "step": 1,
      "title": "ایجاد مدل‌های دیتابیس پیشرفته",
      "file": "detection_models.py",
      "tasks": [
        "مدل DetectionPattern برای ذخیره الگوهای تشخیص",
        "مدل DetectionLog برای لاگ تشخیص‌ها",
        "مدل DetectionFeedback برای بازخورد کاربران",
        "مدل DetectionRule برای قوانین تشخیص سفارشی",
        "مدل BrandAlias برای نام‌های مستعار برندها",
        "مدل VehicleTypeAlias برای نام‌های مستعار انواع خودرو",
        "مدل DetectionStatistics برای آمار تشخیص",
        "افزودن indexes برای بهینه‌سازی"
      ],
      "code_template": "detection_models.py with full SQLAlchemy models"
    },
    {
      "step": 2,
      "title": "بازسازی موتور تشخیص با الگوریتم‌های پیشرفته",
      "file": "brand_vehicle_detector.py",
      "tasks": [
        "الگوریتم تشخیص مبتنی بر Fuzzy Matching",
        "الگوریتم تشخیص مبتنی بر Regular Expressions",
        "الگوریتم تشخیص مبتنی بر TF-IDF",
        "الگوریتم تشخیص مبتنی بر N-gram",
        "ترکیب نتایج با وزن‌دهی",
        "محاسبه امتیاز اطمینان",
        "تشخیص چندگانه",
        "پشتیبانی از فارسی و انگلیسی",
        "کش هوشمند با TTL",
        "پردازش موازی برای عملکرد بهتر"
      ],
      "algorithms": {
        "fuzzy_matching": {
          "library": "fuzzywuzzy",
          "threshold": 85,
          "description": "تطبیق تقریبی برای تشخیص نام‌های مشابه"
        },
        "regex_patterns": {
          "description": "الگوهای منظم برای تشخیص دقیق",
          "examples": [
            "تویوتا|toyota|TOYOTA",
            "هیوندای|hyundai|HYUNDAI",
            "سدان|sedan|SEDAN"
          ]
        },
        "tfidf": {
          "description": "وزن‌دهی کلمات مهم",
          "implementation": "sklearn.feature_extraction.text.TfidfVectorizer"
        },
        "ngram": {
          "description": "تشخیص مبتنی بر توالی کاراکترها",
          "n_values": [2, 3, 4]
        }
      }
    },
    {
      "step": 3,
      "title": "ایجاد سرویس لایه میانی",
      "file": "detection_service.py",
      "tasks": [
        "مدیریت درخواست‌های تشخیص",
        "صف پردازش برای تشخیص دسته‌ای",
        "مدیریت اولویت‌بندی",
        "Rate limiting",
        "لاگینگ جامع",
        "Error handling پیشرفته",
        "Retry mechanism",
        "Timeout management",
        "Result caching",
        "Performance monitoring"
      ],
      "features": {
        "batch_processing": {
          "max_batch_size": 100,
          "parallel_workers": 4,
          "timeout_seconds": 300
        },
        "priority_queue": {
          "high_priority": "Real-time user requests",
          "medium_priority": "Admin bulk operations",
          "low_priority": "Background maintenance"
        },
        "rate_limiting": {
          "requests_per_minute": 100,
          "requests_per_hour": 5000
        }
      }
    },
    {
      "step": 4,
      "title": "ایجاد API endpoints کامل",
      "file": "detection_api.py",
      "endpoints": [
        {
          "path": "/api/detection/detect",
          "method": "POST",
          "description": "تشخیص برند و نوع از متن",
          "authentication": "required",
          "input": {
            "text": "string (required)",
            "mode": "string (auto|brand_only|type_only)",
            "confidence_threshold": "float (0-1)"
          },
          "output": {
            "status": "string",
            "detected_brands": "array",
            "detected_vehicle_types": "array",
            "confidence_scores": "object",
            "processing_time": "integer"
          }
        },
        {
          "path": "/api/detection/batch",
          "method": "POST",
          "description": "تشخیص دسته‌ای",
          "input": {
            "texts": "array of strings",
            "update_database": "boolean"
          }
        },
        {
          "path": "/api/detection/auto-update-products",
          "method": "POST",
          "description": "به‌روزرسانی خودکار محصولات",
          "input": {
            "product_ids": "array (optional)",
            "force_update": "boolean"
          }
        },
        {
          "path": "/api/detection/stats",
          "method": "GET",
          "description": "دریافت آمار تشخیص"
        },
        {
          "path": "/api/detection/feedback",
          "method": "POST",
          "description": "ثبت بازخورد تشخیص",
          "input": {
            "detection_log_id": "integer",
            "is_correct": "boolean",
            "correct_brand_id": "integer (optional)",
            "correct_vehicle_type_ids": "array (optional)"
          }
        },
        {
          "path": "/api/detection/patterns",
          "method": "GET",
          "description": "دریافت الگوهای تشخیص"
        },
        {
          "path": "/api/detection/patterns",
          "method": "POST",
          "description": "افزودن الگوی جدید"
        },
        {
          "path": "/api/detection/learn",
          "method": "POST",
          "description": "یادگیری از بازخوردها"
        }
      ]
    },
    {
      "step": 5,
      "title": "ایجاد ماژول یادگیری خودکار",
      "file": "detection_learning.py",
      "tasks": [
        "تحلیل بازخوردهای کاربران",
        "استخراج الگوهای جدید",
        "بهبود وزن‌های الگوریتم‌ها",
        "شناسایی برندهای جدید",
        "شناسایی نام‌های مستعار",
        "به‌روزرسانی خودکار مدل",
        "ارزیابی عملکرد",
        "گزارش بهبودها"
      ],
      "learning_strategies": [
        "Supervised learning from user feedback",
        "Pattern mining from successful detections",
        "Automatic alias detection",
        "Confidence threshold optimization",
        "Algorithm weight adjustment"
      ]
    },
    {
      "step": 6,
      "title": "ایجاد رابط مدیریت تشخیص",
      "file": "templates/admin/detection_manager.html",
      "sections": [
        {
          "title": "داشبورد",
          "features": [
            "آمار کلی تشخیص",
            "نمودار دقت در طول زaman",
            "محصولات بدون تشخیص",
            "تشخیص‌های با اطمینان پایین",
            "عملکرد الگوریتم‌ها"
          ]
        },
        {
          "title": "تشخیص تکی",
          "features": [
            "فرم ورودی متن",
            "نمایش نتایج آنی",
            "نمایش امتیازات اطمینان",
            "امکان تأیید/اصلاح",
            "تاریخچه تشخیص‌ها"
          ]
        },
        {
          "title": "تشخیص دسته‌ای",
          "features": [
            "انتخاب محصولات",
            "فیلتر محصولات بدون برند",
            "شروع تشخیص دسته‌ای",
            "Progress bar",
            "نمایش نتایج",
            "گزینه بازگشت تغییرات"
          ]
        },
        {
          "title": "مدیریت الگوها",
          "features": [
            "لیست الگوهای فعال",
            "افزودن الگوی جدید",
            "ویرایش الگو",
            "غیرفعال‌سازی الگو",
            "تست الگو",
            "الگوهای پیشنهادی سیستم"
          ]
        },
        {
          "title": "مدیریت نام‌های مستعار",
          "features": [
            "برندها و نام‌های مستعار",
            "انواع خودرو و نام‌های مستعار",
            "افزودن مستعار جدید",
            "ویرایش و حذف"
          ]
        },
        {
          "title": "بازخوردها",
          "features": [
            "لیست بازخوردهای کاربران",
            "بررسی بازخوردها",
            "تأیید و اعمال",
            "رد بازخورد",
            "آمار بازخوردها"
          ]
        },
        {
          "title": "گزارشات",
          "features": [
            "گزارش عملکرد",
            "گزارش خطاها",
            "گزارش بهبودها",
            "Export گزارشات"
          ]
        },
        {
          "title": "تنظیمات",
          "features": [
            "آستانه اطمینان",
            "فعال/غیرفعال الگوریتم‌ها",
            "وزن الگوریتم‌ها",
            "تنظیمات کش",
            "تنظیمات یادگیری خودکار"
          ]
        }
      ]
    },
    {
      "step": 7,
      "title": "ایجاد توابع کمکی",
      "file": "detection_utils.py",
      "utilities": [
        "text_normalizer: نرمال‌سازی متن فارسی و انگلیسی",
        "persian_to_english: تبدیل حروف فارسی به انگلیسی",
        "english_to_persian: تبدیل حروف انگلیسی به فارسی",
        "extract_keywords: استخراج کلمات کلیدی",
        "calculate_confidence: محاسبه امتیاز اطمینان",
        "merge_results: ترکیب نتایج الگوریتم‌ها",
        "export_patterns: Export الگوها به JSON",
        "import_patterns: Import الگوها از JSON",
        "generate_report: تولید گزارش",
        "benchmark: ارزیابی عملکرد"
      ]
    },
    {
      "step": 8,
      "title": "ایجاد تست‌های جامع",
      "file": "tests/test_detection.py",
      "test_categories": [
        {
          "category": "Unit Tests",
          "tests": [
            "test_brand_detection_persian",
            "test_brand_detection_english",
            "test_vehicle_type_detection",
            "test_fuzzy_matching",
            "test_regex_patterns",
            "test_text_normalization",
            "test_confidence_calculation"
          ]
        },
        {
          "category": "Integration Tests",
          "tests": [
            "test_api_endpoints",
            "test_batch_processing",
            "test_database_integration",
            "test_cache_functionality",
            "test_learning_module"
          ]
        },
        {
          "category": "Performance Tests",
          "tests": [
            "test_detection_speed",
            "test_batch_performance",
            "test_memory_usage",
            "test_concurrent_requests"
          ]
        },
        {
          "category": "Accuracy Tests",
          "tests": [
            "test_detection_accuracy",
            "test_false_positive_rate",
            "test_false_negative_rate",
            "test_edge_cases"
          ]
        }
      ],
      "test_data": {
        "sample_products": [
          "لنت ترمز جلو تویوتا کمری",
          "روغن موتور هیوندای سوناتا",
          "فیلتر هوای بنز E کلاس",
          "شمع BMW سری 3",
          "کفی پژو 206 سدان",
          "باتری پراید هاچبک",
          "لاستیک SUV کیا اسپورتیج"
        ],
        "expected_results": "Pre-defined correct detections for validation"
      }
    },
    {
      "step": 9,
      "title": "ایجاد اسکریپت نصب و راه‌اندازی",
      "file": "setup_detection_system.py",
      "tasks": [
        "نصب dependencies مورد نیاز",
        "ایجاد جداول دیتابیس",
        "ایجاد الگوهای پایه",
        "ایجاد نام‌های مستعار پایه",
        "Import داده‌های اولیه",
        "تست سیستم",
        "نمایش گزارش نصب"
      ],
      "dependencies": [
        "fuzzywuzzy",
        "python-Levenshtein",
        "scikit-learn",
        "nltk",
        "hazm (for Persian text processing)",
        "redis (for caching)",
        "celery (for async processing)"
      ]
    },
    {
      "step": 10,
      "title": "ایجاد اسکریپت اجرای یک کلیکی",
      "file": "run_complete_detection.py",
      "description": "اسکریپت اصلی که تمام فرآیند را با یک کلیک انجام می‌دهد",
      "workflow": [
        "بررسی پیش‌نیازها",
        "نصب dependencies",
        "راه‌اندازی دیتابیس",
        "بارگذاری داده‌های پایه",
        "تشخیص خودکار همه محصولات",
        "یادگیری از نتایج",
        "تولید گزارش نهایی",
        "نمایش آمار"
      ]
    }
  ],
  
  "database_schema": {
    "new_tables": [
      {
        "table": "detection_pattern",
        "columns": [
          "id: Integer, Primary Key",
          "pattern_type: String (brand|vehicle_type|model)",
          "pattern: String",
          "target_id: Integer",
          "target_type: String",
          "confidence_weight: Float",
          "is_active: Boolean",
          "usage_count: Integer",
          "success_rate: Float",
          "created_by: Integer, FK(user.id)",
          "created_at: DateTime",
          "updated_at: DateTime"
        ]
      },
      {
        "table": "detection_log",
        "columns": [
          "id: Integer, Primary Key",
          "input_text: String",
          "detected_brand_id: Integer, FK(brand.id)",
          "detected_vehicle_types: JSON",
          "confidence_scores: JSON",
          "algorithm_used: String",
          "processing_time_ms: Integer",
          "is_verified: Boolean",
          "verified_by: Integer, FK(user.id)",
          "verification_date: DateTime",
          "created_at: DateTime"
        ]
      },
      {
        "table": "detection_feedback",
        "columns": [
          "id: Integer, Primary Key",
          "detection_log_id: Integer, FK(detection_log.id)",
          "user_id: Integer, FK(user.id)",
          "is_correct: Boolean",
          "correct_brand_id: Integer, FK(brand.id)",
          "correct_vehicle_types: JSON",
          "feedback_text: Text",
          "created_at: DateTime"
        ]
      },
      {
        "table": "brand_alias",
        "columns": [
          "id: Integer, Primary Key",
          "brand_id: Integer, FK(brand.id)",
          "alias: String",
          "language: String (fa|en)",
          "is_active: Boolean",
          "created_at: DateTime"
        ]
      },
      {
        "table": "vehicle_type_alias",
        "columns": [
          "id: Integer, Primary Key",
          "vehicle_type_id: Integer, FK(vehicle_type.id)",
          "alias: String",
          "language: String (fa|en)",
          "is_active: Boolean",
          "created_at: DateTime"
        ]
      },
      {
        "table": "detection_statistics",
        "columns": [
          "id: Integer, Primary Key",
          "date: Date",
          "total_detections: Integer",
          "successful_detections: Integer",
          "failed_detections: Integer",
          "average_confidence: Float",
          "average_processing_time: Float",
          "brands_detected: JSON",
          "vehicle_types_detected: JSON",
          "created_at: DateTime"
        ]
      }
    ]
  },
  
  "detection_rules": {
    "brand_detection": {
      "priority": [
        "Exact match (highest priority)",
        "Fuzzy match with high score (>90)",
        "Regex pattern match",
        "TF-IDF similarity",
        "N-gram similarity",
        "Alias match"
      ],
      "confidence_calculation": {
        "exact_match": 1.0,
        "fuzzy_high": 0.9,
        "fuzzy_medium": 0.7,
        "regex_match": 0.85,
        "tfidf_high": 0.75,
        "ngram_high": 0.7,
        "alias_match": 0.95
      }
    },
    "vehicle_type_detection": {
      "priority": "Similar to brand detection",
      "multi_type_handling": "Allow multiple types if confidence > threshold"
    },
    "conflict_resolution": {
      "strategy": "Weighted voting",
      "min_algorithms": 2,
      "agreement_threshold": 0.6
    }
  },
  
  "performance_targets": {
    "single_detection": {
      "target_time_ms": 10,
      "max_time_ms": 50
    },
    "batch_detection_100": {
      "target_time_seconds": 2,
      "max_time_seconds": 10
    },
    "accuracy": {
      "target_accuracy": 0.95,
      "min_accuracy": 0.90
    },
    "memory_usage": {
      "max_memory_mb": 500
    }
  },
  
  "user_interface": {
    "admin_pages": [
      {
        "url": "/admin/detection",
        "title": "مدیریت تشخیص خودکار",
        "features": [
          "داشبورد آمار",
          "تشخیص تکی",
          "تشخیص دسته‌ای",
          "مدیریت الگوها",
          "مدیریت نام‌های مستعار",
          "بازخوردها",
          "گزارشات",
          "تنظیمات"
        ]
      }
    ],
    "user_features": [
      {
        "location": "Product detail page",
        "feature": "نمایش برند و نوع تشخیص داده شده",
        "action": "گزینه گزارش اشتباه"
      },
      {
        "location": "Product list page",
        "feature": "فیلتر بر اساس برند و نوع تشخیص شده"
      }
    ]
  },
  
  "monitoring_and_logging": {
    "metrics": [
      "تعداد تشخیص‌های موفق",
      "تعداد تشخیص‌های ناموفق",
      "میانگین زمان پردازش",
      "میانگین امتیاز اطمینان",
      "تعداد بازخوردهای کاربران",
      "نرخ صحت تشخیص",
      "الگوریتم‌های پرکاربرد",
      "برندهای پرتکرار"
    ],
    "alerts": [
      {
        "condition": "accuracy < 0.90",
        "action": "Send email to admin"
      },
      {
        "condition": "processing_time > 50ms",
        "action": "Log warning"
      },
      {
        "condition": "detection_failures > 10% in 1 hour",
        "action": "Send alert"
      }
    ]
  },
  
  "initial_data": {
    "brand_aliases": {
      "Toyota": ["تویوتا", "TOYOTA", "toyota", "تويوتا"],
      "Hyundai": ["هیوندای", "هیوندا", "HYUNDAI", "hyundai", "هيونداي"],
      "Benz": ["بنز", "مرسدس", "Mercedes", "BENZ", "بنز"],
      "BMW": ["بی‌ام‌و", "بی ام و", "BMW", "bmw"],
      "Peugeot": ["پژو", "پژو", "PEUGEOT", "peugeot"],
      "Pride": ["پراید", "PRIDE", "pride"],
