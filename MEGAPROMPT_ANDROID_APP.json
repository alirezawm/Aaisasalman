{
  "project_name": "Asia Salman Auto Parts - Android Application",
  "version": "1.0.0",
  "description": "مگا پرامپت حرفه‌ای برای ساخت نرم‌افزار اندروید قطعات خودرو آسیا سلمان",
  "target_platform": "Android",
  "minimum_sdk": 21,
  "target_sdk": 34,
  "compatibility": "Android 5.0 (Lollipop) تا Android 14+",
  
  "technical_requirements": {
    "architecture": {
      "pattern": "MVVM (Model-View-ViewModel)",
      "libraries": [
        "Android Architecture Components (ViewModel, LiveData, Room)",
        "Kotlin Coroutines",
        "Retrofit 2 for API calls",
        "OkHttp for HTTP client",
        "Gson for JSON parsing",
        "Glide for image loading",
        "Material Design Components 3",
        "Navigation Component",
        "Hilt for Dependency Injection"
      ]
    },
    "ui_framework": {
      "base": "Jetpack Compose (Modern UI) + XML (for compatibility)",
      "design_system": "Material Design 3",
      "animations": "Lottie animations, MotionLayout, Shared Element Transitions",
      "theme": "Dark mode support, RTL support, Persian/Arabic fonts"
    },
    "networking": {
      "base_url": "https://your-domain.com/api/mobile/v1",
      "authentication": "JWT Bearer Token",
      "retry_policy": "Exponential backoff with 3 retries",
      "caching": "OkHttp cache + Room database for offline support",
      "timeout": {
        "connect": 30,
        "read": 30,
        "write": 30
      }
    },
    "local_storage": {
      "database": "Room Database",
      "preferences": "DataStore (replacing SharedPreferences)",
      "cache": "DiskLruCache for images and API responses"
    },
    "performance": {
      "image_loading": "Glide with memory and disk caching",
      "pagination": "Paging 3 library for infinite scrolling",
      "background_work": "WorkManager for background tasks",
      "memory_management": "LeakCanary for memory leak detection"
    }
  },

  "api_endpoints": {
    "base_url": "/api/mobile/v1",
    "authentication": {
      "send_otp": {
        "endpoint": "/auth/send-otp",
        "method": "POST",
        "request": {
          "phone": "string (required, format: 09123456789)"
        },
        "response": {
          "success": "boolean",
          "message": "string",
          "data": {
            "expires_in": "integer (seconds)"
          }
        }
      },
      "verify_otp": {
        "endpoint": "/auth/verify-otp",
        "method": "POST",
        "request": {
          "phone": "string (required)",
          "otp_code": "string (required)"
        },
        "response": {
          "success": "boolean",
          "message": "string",
          "data": {
            "access_token": "string (JWT)",
            "refresh_token": "string (JWT)",
            "user": {
              "id": "integer",
              "username": "string",
              "full_name": "string",
              "phone": "string",
              "email": "string",
              "company_name": "string",
              "is_bulk_buyer": "boolean",
              "bulk_buyer_approval_status": "string (pending|approved|rejected)",
              "profile_completion_percentage": "integer"
            },
            "expires_in": "integer (seconds)"
          }
        }
      },
      "refresh_token": {
        "endpoint": "/auth/refresh-token",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {refresh_token}"
        },
        "response": {
          "success": "boolean",
          "data": {
            "access_token": "string"
          }
        }
      },
      "logout": {
        "endpoint": "/auth/logout",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {access_token}"
        }
      }
    },
    "products": {
      "list": {
        "endpoint": "/products",
        "method": "GET",
        "query_params": {
          "page": "integer (default: 1)",
          "per_page": "integer (default: 20, max: 100)",
          "brand_id": "integer (optional)",
          "category_id": "integer (optional)",
          "vehicle_type_id": "integer (optional)",
          "product_type_id": "integer (optional)",
          "min_price": "integer (optional)",
          "max_price": "integer (optional)",
          "in_stock": "boolean (optional)",
          "has_discount": "boolean (optional)",
          "search": "string (optional)"
        },
        "response": {
          "success": "boolean",
          "data": {
            "products": [
              {
                "id": "integer",
                "name": "string",
                "name_fa": "string",
                "sku": "string",
                "oem_code": "string",
                "description": "string",
                "description_fa": "string",
                "image_url": "string",
                "images": ["array of image URLs"],
                "price_cash": "integer (Rials)",
                "price_check": "integer (Rials)",
                "price_cash_bulk": "integer (Rials, if user is bulk buyer)",
                "price_check_bulk": "integer (Rials, if user is bulk buyer)",
                "discount_percentage": "float (if has discount)",
                "discounted_price_cash": "integer (if has discount)",
                "discounted_price_check": "integer (if has discount)",
                "stock_quantity": "integer",
                "is_active": "boolean",
                "brand": {
                  "id": "integer",
                  "name": "string",
                  "name_fa": "string",
                  "logo_url": "string"
                },
                "category": {
                  "id": "integer",
                  "name": "string",
                  "name_fa": "string"
                },
                "vehicle_type": {
                  "id": "integer",
                  "name": "string",
                  "name_fa": "string"
                },
                "product_type": {
                  "id": "integer",
                  "name": "string",
                  "name_fa": "string"
                }
              }
            ],
            "pagination": {
              "page": "integer",
              "per_page": "integer",
              "total": "integer",
              "pages": "integer",
              "has_next": "boolean",
              "has_prev": "boolean"
            }
          }
        }
      },
      "detail": {
        "endpoint": "/products/{id}",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer {access_token} (optional, for bulk prices)"
        },
        "response": {
          "success": "boolean",
          "data": {
            "product": "product object (same as list, with full details)"
          }
        }
      },
      "search": {
        "endpoint": "/products/search",
        "method": "GET",
        "query_params": {
          "q": "string (required)",
          "page": "integer (default: 1)",
          "per_page": "integer (default: 20)",
          "filters": "JSON string (optional)"
        },
        "response": "same as products list"
      },
      "filters": {
        "endpoint": "/products/filters",
        "method": "GET",
        "response": {
          "success": "boolean",
          "data": {
            "brands": ["array of brand objects"],
            "categories": ["array of category objects"],
            "vehicle_types": ["array of vehicle type objects"],
            "product_types": ["array of product type objects"],
            "price_range": {
              "min": "integer",
              "max": "integer"
            }
          }
        }
      }
    },
    "categories": {
      "list": {
        "endpoint": "/categories",
        "method": "GET",
        "response": {
          "success": "boolean",
          "data": {
            "categories": ["array of category objects"]
          }
        }
      },
      "vehicle_based": {
        "endpoint": "/categories/vehicle-based",
        "method": "GET",
        "response": {
          "success": "boolean",
          "data": {
            "vehicle_types": [
              {
                "id": "integer",
                "name": "string",
                "name_fa": "string",
                "icon_url": "string",
                "categories": ["array of categories for this vehicle type"]
              }
            ]
          }
        }
      },
      "brand_based": {
        "endpoint": "/categories/brand-based",
        "method": "GET",
        "response": {
          "success": "boolean",
          "data": {
            "brands": [
              {
                "id": "integer",
                "name": "string",
                "name_fa": "string",
                "logo_url": "string",
                "categories": ["array of categories for this brand"]
              }
            ]
          }
        }
      },
      "product_type_based": {
        "endpoint": "/categories/product-type-based",
        "method": "GET",
        "response": {
          "success": "boolean",
          "data": {
            "product_types": [
              {
                "id": "integer",
                "name": "string",
                "name_fa": "string",
                "icon_url": "string",
                "categories": ["array of categories for this product type"]
              }
            ]
          }
        }
      },
      "products": {
        "endpoint": "/categories/{id}/products",
        "method": "GET",
        "query_params": {
          "page": "integer (default: 1)",
          "per_page": "integer (default: 20)"
        },
        "response": "same as products list"
      }
    },
    "discounts": {
      "daily_products": {
        "endpoint": "/discounts/daily-products",
        "method": "GET",
        "query_params": {
          "limit": "integer (default: 20)",
          "offset": "integer (default: 0)"
        },
        "response": {
          "success": "boolean",
          "data": {
            "products": ["array of discounted product objects"],
            "discount_info": {
              "name": "string",
              "name_fa": "string",
              "discount_percentage": "float"
            }
          }
        }
      },
      "monthly_products": {
        "endpoint": "/discounts/monthly-products",
        "method": "GET",
        "query_params": {
          "limit": "integer (default: 20)",
          "offset": "integer (default: 0)"
        },
        "response": "same as daily_products"
      }
    },
    "cart": {
      "get": {
        "endpoint": "/cart",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer {access_token} (required)"
        },
        "query_params": {
          "price_type": "string (optional: cash|check)"
        },
        "response": {
          "success": "boolean",
          "data": {
            "cash_cart": {
              "items": [
                {
                  "id": "integer (cart_item_id)",
                  "product": "product object",
                  "quantity": "integer",
                  "unit_price_cash": "integer",
                  "total_price_cash": "integer"
                }
              ],
              "total": "integer",
              "item_count": "integer"
            },
            "check_cart": {
              "items": ["same structure as cash_cart"],
              "total": "integer",
              "item_count": "integer"
            },
            "grand_total": "integer",
            "total_items": "integer"
          }
        }
      },
      "add": {
        "endpoint": "/cart",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {access_token} (required)"
        },
        "request": {
          "product_id": "integer (required)",
          "quantity": "integer (required, min: 1)",
          "price_type": "string (required: cash|check)",
          "price_plan": "string (optional: isaco_cash|isaco_1m|isaco_2m|isaco_3m)"
        },
        "response": {
          "success": "boolean",
          "message": "string",
          "data": {
            "cart_item": "cart item object"
          }
        }
      },
      "update": {
        "endpoint": "/cart/{cart_item_id}",
        "method": "PUT",
        "headers": {
          "Authorization": "Bearer {access_token} (required)"
        },
        "request": {
          "quantity": "integer (required, min: 1)"
        },
        "response": {
          "success": "boolean",
          "message": "string"
        }
      },
      "remove": {
        "endpoint": "/cart/{cart_item_id}",
        "method": "DELETE",
        "headers": {
          "Authorization": "Bearer {access_token} (required)"
        },
        "response": {
          "success": "boolean",
          "message": "string"
        }
      },
      "clear": {
        "endpoint": "/cart/clear",
        "method": "DELETE",
        "headers": {
          "Authorization": "Bearer {access_token} (required)"
        },
        "query_params": {
          "price_type": "string (optional: cash|check, if not provided clears both)"
        },
        "response": {
          "success": "boolean",
          "message": "string"
        }
      }
    },
    "user": {
      "profile": {
        "get": {
          "endpoint": "/user/profile",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer {access_token} (required)"
          },
          "response": {
            "success": "boolean",
            "data": {
              "user": {
                "id": "integer",
                "username": "string",
                "full_name": "string",
                "phone": "string",
                "email": "string",
                "company_name": "string",
                "national_id": "string",
                "birth_date": "string (ISO date)",
                "address": "string",
                "landline_phone": "string",
                "secondary_phone": "string",
                "is_bulk_buyer": "boolean",
                "bulk_buyer_approval_status": "string",
                "profile_completion_percentage": "integer",
                "avatar_url": "string",
                "created_at": "string (ISO datetime)",
                "last_login": "string (ISO datetime)"
              }
            }
          }
        },
        "update": {
          "endpoint": "/user/profile",
          "method": "PUT",
          "headers": {
            "Authorization": "Bearer {access_token} (required)"
          },
          "request": {
            "full_name": "string (optional)",
            "email": "string (optional)",
            "company_name": "string (optional)",
            "national_id": "string (optional)",
            "birth_date": "string (optional, ISO date)",
            "address": "string (optional)",
            "landline_phone": "string (optional)",
            "secondary_phone": "string (optional)",
            "avatar": "file (optional, multipart/form-data)"
          },
          "response": {
            "success": "boolean",
            "message": "string",
            "data": {
              "user": "updated user object"
            }
          }
        }
      },
      "bulk_buyer_request": {
        "endpoint": "/user/bulk-buyer-request",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {access_token} (required)"
        },
        "request": {
          "company_name": "string (required)",
          "national_id": "string (required)",
          "address": "string (required)",
          "landline_phone": "string (required)",
          "description": "string (optional)"
        },
        "response": {
          "success": "boolean",
          "message": "string",
          "data": {
            "request_status": "string (pending)"
          }
        }
      },
      "notifications": {
        "endpoint": "/user/notifications",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer {access_token} (required)"
        },
        "query_params": {
          "page": "integer (default: 1)",
          "per_page": "integer (default: 20)",
          "unread_only": "boolean (default: false)"
        },
        "response": {
          "success": "boolean",
          "data": {
            "notifications": [
              {
                "id": "integer",
                "title": "string",
                "message": "string",
                "type": "string",
                "is_read": "boolean",
                "created_at": "string (ISO datetime)",
                "action_url": "string (optional)"
              }
            ],
            "unread_count": "integer",
            "pagination": "pagination object"
          }
        }
      },
      "mark_notification_read": {
        "endpoint": "/user/notifications/{id}/read",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer {access_token} (required)"
        },
        "response": {
          "success": "boolean",
          "message": "string"
        }
      }
    },
    "company": {
      "info": {
        "endpoint": "/company/info",
        "method": "GET",
        "response": {
          "success": "boolean",
          "data": {
            "name": "string",
            "name_fa": "string",
            "logo_url": "string",
            "description": "string",
            "description_fa": "string",
            "phone": "string",
            "support_phone": "string",
            "email": "string",
            "address": "string",
            "about": "string",
            "about_fa": "string",
            "partner_brands": [
              {
                "id": "integer",
                "name": "string",
                "name_fa": "string",
                "logo_url": "string"
              }
            ]
          }
        }
      },
      "banners": {
        "endpoint": "/company/banners",
        "method": "GET",
        "response": {
          "success": "boolean",
          "data": {
            "banners": [
              {
                "id": "integer",
                "title": "string",
                "title_fa": "string",
                "image_url": "string",
                "link_url": "string (optional)",
                "position": "string",
                "is_active": "boolean"
              }
            ]
          }
        }
      }
    },
    "app_config": {
      "endpoint": "/app/config",
      "method": "GET",
      "response": {
        "success": "boolean",
        "data": {
          "app_version": "string",
          "min_app_version": "string",
          "force_update": "boolean",
          "maintenance_mode": "boolean",
          "features": {
            "daily_suggestions_enabled": "boolean",
            "wholesale_requests_enabled": "boolean",
            "wallet_enabled": "boolean",
            "notifications_enabled": "boolean"
          },
          "settings": {
            "default_price_type": "string (cash|check)",
            "show_bulk_prices": "boolean",
            "enable_offline_mode": "boolean"
          },
          "daily_suggestions": {
            "enabled": "boolean",
            "title": "string",
            "title_fa": "string",
            "product_ids": ["array of product IDs"],
            "updated_at": "string (ISO datetime)"
          }
        }
      }
    }
  },

  "app_structure": {
    "splash_screen": {
      "description": "صفحه ابتدایی با لوگو شرکت و انیمیشن لودینگ",
      "features": [
        "نمایش لوگو شرکت با انیمیشن fade in و scale",
        "انیمیشن لودینگ (Lottie animation یا ProgressBar با انیمیشن)",
        "بررسی اتصال به اینترنت",
        "بررسی نسخه اپلیکیشن (force update اگر نیاز باشد)",
        "بررسی وضعیت maintenance mode",
        "بارگذاری تنظیمات اولیه از API",
        "انتقال به صفحه ورود یا صفحه اصلی (اگر لاگین باشد)",
        "مدت زمان نمایش: 2-3 ثانیه"
      ],
      "animations": [
        "Fade in لوگو (duration: 800ms)",
        "Scale animation برای لوگو (duration: 1000ms)",
        "Rotating loader یا Lottie animation",
        "Smooth transition به صفحه بعدی"
      ]
    },
    "authentication": {
      "login_screen": {
        "description": "صفحه ورود با شماره تلفن",
        "features": [
          "ورودی شماره تلفن با فرمت ایرانی (09123456789)",
          "اعتبارسنجی شماره تلفن (شروع با 09 و 11 رقم)",
          "ارسال OTP با دکمه زیبا و انیمیشن",
          "نمایش تایمر برای ارسال مجدد OTP (120 ثانیه)",
          "صفحه تایید OTP با 6 خانه برای کد",
          "Auto-focus و auto-submit پس از وارد کردن 6 رقم",
          "انیمیشن shake در صورت خطا",
          "ذخیره توکن JWT پس از ورود موفق",
          "انتقال به صفحه اصلی یا تکمیل پروفایل"
        ],
        "ui_elements": [
          "Material Design TextInputLayout برای شماره تلفن",
          "OTP input با 6 خانه جداگانه",
          "دکمه ارسال/تایید با ripple effect",
          "Progress indicator هنگام ارسال",
          "Error messages با Snackbar"
        ]
      },
      "profile_completion": {
        "description": "تکمیل اطلاعات پروفایل برای کاربران جدید",
        "features": [
          "فرم چند مرحله‌ای (Stepper) برای تکمیل اطلاعات",
          "مرحله 1: اطلاعات شخصی (نام، نام خانوادگی، ایمیل)",
          "مرحله 2: اطلاعات تماس (تلفن ثابت، تلفن دوم)",
          "مرحله 3: اطلاعات شرکت (نام شرکت، کد ملی، آدرس)",
          "Progress indicator برای نمایش پیشرفت",
          "ذخیره موقت اطلاعات در صورت بستن اپ",
          "اعتبارسنجی فیلدها",
          "انیمیشن transition بین مراحل"
        ]
      }
    },
    "main_screen": {
